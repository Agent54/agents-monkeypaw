  "provider": {
    "openrouter": {
      "models": {
        // Force-register Amp target models even if local catalogs are stale.
        "anthropic/claude-opus-4.6": {},
        "anthropic/claude-sonnet-4.6": {},
        "anthropic/claude-haiku-4.5": {},
        "openai/gpt-5.3-codex": {
          //         "openai/gpt-5.3-codex": {
          //           "name": "GPT-5.3-Codex",
          //           "reasoning": true,
          //           "attachment": true,
          //           "tool_call": true,
          //           "structured_output": true,
          //           "cost": {
          //             "input": 1.75,
          //             "output": 14,
          //             "cache_read": 0.175
          //           },
          //           "limit": {
          //             "context": 400000,
          //             "output": 128000
          //           },
          //           "modalities": {
          //             "input": [
          //               "text",
          //               "image"
          //             ],
          //             "output": [
          //               "text"
          //             ]
          //           },
          //           "options": {
          //             "reasoningEffort": "medium",
          //             "reasoningSummary": "auto",
          //             "temperature": 1
          //           }
          //         }
        },
        "openai/gpt-5.4": {}
      }
    }
  },

  "model": "openrouter/anthropic/claude-opus-4.6",
  "small_model": "openrouter/anthropic/claude-haiku-4.5",
  "default_agent": "smart",

  "agent": {
    "smart": {
      "description": "Amp Smart mode: most capable default coding agent.",
      "mode": "primary",
      "model": "openrouter/anthropic/claude-opus-4.6",
      "prompt": "{file:./prompts/amp-smart.prompt.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "list": true,
        "bash": true,
        "edit": true,
        "write": true,
        "patch": true,
        "websearch": true,
        "webfetch": true,
        "skill": true,
        "task": true,
        "todoread": true,
        "todowrite": true,
        "question": true,
        "lsp": true
      },
      "permission": {
        "task": {
          "*": "deny",
          "finder": "allow",
          "oracle": "allow",
          "librarian": "allow"
        }
      }
    },

    "rush": {
      "description": "Amp Rush mode: fast + concise execution.",
      "mode": "primary",
      "model": "openrouter/anthropic/claude-haiku-4.5",
      "prompt": "{file:./prompts/amp-rush.prompt.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "list": true,
        "bash": true,
        "edit": true,
        "write": true,
        "patch": true,
        "websearch": true,
        "webfetch": true,
        "skill": true,
        "task": true,
        "todoread": true,
        "todowrite": true,
        "question": true,
        "lsp": true
      },
      "permission": {
        "task": {
          "*": "deny",
          "finder": "allow",
          "oracle": "allow",
          "librarian": "allow"
        }
      }
    },

    "deep": {
      "description": "Amp Deep mode: Codex-heavy deep reasoning.",
      "mode": "primary",
      "model": "openrouter/openai/gpt-5.3-codex",
      "reasoningEffort": "high",
      "prompt": "{file:./prompts/amp-deep.prompt.md}",
      "tools": {
        "read": false,
        "grep": false,
        "glob": false,
        "list": false,
        "bash": true,
        "edit": false,
        "write": false,
        "patch": true,
        "websearch": true,
        "webfetch": true,
        "skill": true,
        "task": true,
        "todoread": false,
        "todowrite": false,
        "question": true,
        "lsp": false
      },
      "permission": {
        "task": {
          "*": "deny",
          "finder": "allow",
          "librarian": "allow"
        }
      }
    },

    "free": {
      "description": "Amp Free mode behavior/prompt profile.",
      "mode": "primary",
      "model": "openrouter/anthropic/claude-haiku-4.5",
      "prompt": "{file:./prompts/amp-free.prompt.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "list": true,
        "bash": true,
        "edit": true,
        "write": true,
        "patch": true,
        "websearch": true,
        "webfetch": true,
        "skill": true,
        "task": false,
        "todoread": true,
        "todowrite": true,
        "question": true,
        "lsp": true
      }
    },

    "large": {
      "description": "Amp Large mode equivalent (Sonnet 4.6).",
      "mode": "primary",
      "model": "openrouter/anthropic/claude-sonnet-4.6",
      "prompt": "{file:./prompts/amp-smart.prompt.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "list": true,
        "bash": true,
        "edit": true,
        "write": true,
        "patch": true,
        "websearch": true,
        "webfetch": true,
        "skill": true,
        "task": true,
        "todoread": true,
        "todowrite": true,
        "question": true,
        "lsp": true
      },
      "permission": {
        "task": {
          "*": "deny",
          "finder": "allow",
          "oracle": "allow",
          "librarian": "allow"
        }
      }
    },

    "agg-man": {
      "description": "Amp hidden Agg mode mapped as hidden subagent.",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/anthropic/claude-opus-4.6",
      "prompt": "{file:./prompts/amp-agg-man.prompt.md}",
      "tools": {
        "read": true,
        "websearch": true,
        "webfetch": true,
        "edit": false,
        "write": false,
        "patch": false,
        "bash": false
      }
    },

    "finder": {
      "description": "Amp Finder subagent (parallel code search).",
      "mode": "subagent",
      "model": "openrouter/anthropic/claude-haiku-4.5",
      "prompt": "{file:./prompts/amp-finder.prompt.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "list": true,
        "bash": false,
        "edit": false,
        "write": false,
        "patch": false,
        "task": false,
        "skill": false,
        "websearch": false,
        "webfetch": false
      }
    },

    "oracle": {
      "description": "Amp Oracle advisor subagent.",
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5.2",
      "prompt": "{file:./prompts/amp-oracle.prompt.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "websearch": true,
        "webfetch": true,
        "bash": false,
        "edit": false,
        "write": false,
        "patch": false,
        "task": false
      }
    },

    "librarian": {
      "description": "Amp Librarian multi-repo understanding subagent.",
      "mode": "subagent",
      "model": "openrouter/anthropic/claude-sonnet-4.6",
      "prompt": "{file:./prompts/amp-librarian.prompt.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "websearch": true,
        "webfetch": true,
        "bash": false,
        "edit": false,
        "write": false,
        "patch": false,
        "task": false
      }
    }
  },

  // Conservative defaults; relax if you want Amp-like permissive behavior.
  "permission": {
    "external_directory": "ask",
    "doom_loop": "ask"
  }
}
